# PayPal sandbox app keys (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Leave empty to run with a simulated PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: a saved sandbox PayPal (vault id) that demo workspaces pay with
# until a visitor connects their own sandbox account.
DEMO_VAULT_ID=

# Anthropic key for the shopping agent. Without it the agent runs a scripted demo.
ANTHROPIC_API_KEY=

# Public URL of this app (used for PayPal return links and phone approval QR codes).
APP_URL=http://localhost:3000
